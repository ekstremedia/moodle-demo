#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
    echo 'Docker with Compose and curl are required.' >&2
    exit 1
fi
if [ ! -f .env ]; then
    umask 077
    db_password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
    admin_password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
    cat > .env <<EOF
DB_PASSWORD=$db_password
ADMIN_PASSWORD=$admin_password
MOODLE_WWWROOT=http://localhost:8080
EOF
    echo 'Created .env with local passwords.'
fi
docker compose up -d --build db web
if ! docker compose exec -T db sh -c 'psql -U moodle -d moodle -Atqc "SELECT to_regclass('\''public.mdl_config'\'')"' | grep -qx mdl_config; then
    echo 'Installing Moodle database...'
    docker compose exec -T -u www-data web sh -c 'php admin/cli/install_database.php --lang=en --adminuser=admin --adminpass="$ADMIN_PASSWORD" --adminemail=admin@example.invalid --fullname="Moodle LMS" --shortname="Moodle" --agree-license'
else
    docker compose exec -T -u www-data web php admin/cli/upgrade.php --non-interactive
fi
docker compose up -d --build cron
ready=0
for attempt in $(seq 1 30); do
    if curl -fsS -o /dev/null http://localhost:8080/login/index.php; then
        ready=1
        break
    fi
    sleep 1
done
if [ "$ready" -ne 1 ]; then
    echo 'Moodle did not become ready at http://localhost:8080' >&2
    exit 1
fi
echo 'Ready: http://localhost:8080'
echo 'Sign in as admin with ADMIN_PASSWORD from .env'
