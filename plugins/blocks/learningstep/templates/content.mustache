{{!
    @template block_learningstep/content
    A server-rendered learning step. All content is escaped; native form controls work without JS.
    Example context (json):
    {"actionurl":"/blocks/learningstep/action.php","sesskey":"example","step":0,
     "progress":"0 av 5 steg gjennomgått","questionvisible":true,"question":"Hvordan kan barnet delta i leken?",
     "options":[{"value":0,"label":"Gi barnet tid til å svare"}]}
}}
<div class="learningstep" lang="nb">
    {{^done}}<p>{{#str}}intro, block_learningstep{{/str}}</p>{{/done}}
    <p class="learningstep-error" role="alert" tabindex="-1" hidden>{{#str}}submiterror, block_learningstep{{/str}}</p>
    <p class="learningstep-progress">{{progress}}</p>
    {{#questionvisible}}
    <form method="post" action="{{actionurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="step" value="{{step}}">
        <input type="hidden" name="action" value="answer">
        <fieldset>
            <legend id="learningstep" tabindex="-1">{{question}}</legend>
            {{#options}}
            <label class="learningstep-option">
                <input type="radio" name="answer" value="{{value}}" required>
                <span>{{label}}</span>
            </label>
            {{/options}}
        </fieldset>
        <div class="learningstep-actions">
            <p>{{#str}}answerhint, block_learningstep{{/str}}</p>
            <button class="btn btn-primary" type="submit">{{#str}}submit, block_learningstep{{/str}}</button>
        </div>
    </form>
    {{/questionvisible}}
    {{#answered}}
    <div class="learningstep-feedback">
        <h3 id="learningstep" class="h5" tabindex="-1">{{feedback}}</h3>
        <p>{{#str}}youranswer, block_learningstep{{/str}} {{selected}}</p>
        <p>{{explanation}}</p>
    </div>
    <form method="post" action="{{actionurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="step" value="{{step}}">
        <button class="btn btn-primary" type="submit" name="action" value="next">{{#laststep}}{{#str}}finish, block_learningstep{{/str}}{{/laststep}}{{^laststep}}{{#str}}next, block_learningstep{{/str}}{{/laststep}}</button>
    </form>
    {{/answered}}
    {{#done}}
    <section class="learningstep-complete" aria-labelledby="learningstep">
        <h3 id="learningstep" class="h5" tabindex="-1">{{#str}}complete, block_learningstep{{/str}}</h3>
        <p>{{#str}}completebody, block_learningstep{{/str}}</p>
        <h4 class="h6">{{#str}}reviewed, block_learningstep{{/str}}</h4>
        <ul class="learningstep-topics">
            {{#topics}}<li>{{label}}</li>{{/topics}}
        </ul>
        <a href="https://www.statped.no/tiltak-og-tilrettelegging/">{{#str}}resources, block_learningstep{{/str}}</a>
    </section>
    {{/done}}
    <footer class="learningstep-footer">
        <p>{{#str}}privacyhint, block_learningstep{{/str}}</p>
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="step" value="{{step}}">
            <button class="btn btn-outline-secondary btn-sm" type="submit" name="action" value="reset">{{#done}}{{#str}}restart, block_learningstep{{/str}}{{/done}}{{^done}}{{#str}}reset, block_learningstep{{/str}}{{/done}}</button>
        </form>
        <small>{{#str}}demonote, block_learningstep{{/str}}</small>
    </footer>
</div>
